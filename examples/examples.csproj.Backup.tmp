<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<ImplicitUsings>disable</ImplicitUsings>
		<LangVersion>14</LangVersion>
		<Nullable>enable</Nullable>
		<TargetFramework>net10.0</TargetFramework>
		<RestoreAdditionalProjectSources>$(MSBuildProjectDirectory)\..\sdk-package</RestoreAdditionalProjectSources>
	</PropertyGroup>
	
	<ItemGroup>
		<PackageReference Include="Hiero" Version="*" />
		<PackageReference Include="Hiero.Proto" Version="*" />
		<PackageReference Include="Hiero.Reference" Version="*" />
		<PackageReference Include="Hiero.SDK" Version="*" />
	</ItemGroup>

</Project>
